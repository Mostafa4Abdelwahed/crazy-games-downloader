# Local defaults — copy to .env and fill in. Never commit secrets.
PORT=3000

# Database: sqlite file by default; set DATABASE_URL for postgres
# e.g. DATABASE_URL=postgres://user:pass@localhost:5432/games
DATABASE_URL=
SQLITE_PATH=./data/app.sqlite

# Redis (BullMQ). If empty, app uses in-memory queue driver (dev/test only).
REDIS_URL=

# Queue
QUEUE_DRIVER=memory
IMPORT_CONCURRENCY=2
IMPORT_JOB_TIMEOUT_MS=600000
IMPORT_MAX_DOWNLOAD_BYTES=536870912
IMPORT_MAX_EXTRACTED_BYTES=1073741824
IMPORT_WORK_DIR=./data/work
IMPORT_PACKAGE_DIR=./data/packages

# Source policy: comma-separated allowed hosts + whether to allow arbitrary https
# Keep ALLOW_ANY_HTTPS=false in production; explicitly allowlist redistribution partners.
SOURCE_ALLOWED_HOSTS=localhost
ALLOW_ANY_HTTPS=false
BLOCK_PRIVATE_NETWORKS=true
CLOUD_METADATA_BLOCK=true

# Storage (M3: local only — no S3/R2/CDN/remote storage; that is a future milestone)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/packages

# Worker isolation
WORKER_TIMEOUT_MS=600000
WORKER_MAX_MEMORY_MB=1024
WORKER_MAX_DISK_MB=2048

# Runtime validation (M3, Playwright + local HTTP server)
RUNTIME_VALIDATION_TIMEOUT_MS=30000
# Post-boot settle window: keep observing after init so late StreamingAssets
# 404s / FMOD bank failures fail the run instead of a premature RUNTIME_OK.
RUNTIME_VALIDATION_SETTLE_MS=5000
# Upper bound for a single DOM/flag probe (wedged renderers must not stall).
RUNTIME_VALIDATION_PROBE_TIMEOUT_MS=10000
# Optional explicit Chromium executable (defaults to Playwright's cached browser)
PLAYWRIGHT_EXECUTABLE_PATH=

# Unity StreamingAssets dependency discovery (M3.2, generic — no filenames).
# Bounded + SourcePolicy-gated. Remote observation loads the authorized entry
# in headless Chromium; local observation boots the provisional package.
UNITY_STREAMING_ASSETS_MAX_FILES=200
UNITY_STREAMING_ASSETS_MAX_BYTES=536870912
UNITY_STREAMING_ASSETS_DISCOVERY_TIMEOUT_MS=45000
UNITY_STREAMING_ASSETS_REQUEST_TIMEOUT_MS=60000
UNITY_STREAMING_ASSETS_RUNTIME_DISCOVERY=true
UNITY_STREAMING_ASSETS_LOCAL_DISCOVERY=true
UNITY_STREAMING_ASSETS_LOCAL_TIMEOUT_MS=30000

# Opt-in real-world validation ONLY (never set in CI):
# requires explicit authorization to import/redistribute the tested game,
# and the host must also satisfy SOURCE_ALLOWED_HOSTS + SSRF guards.
# REAL_TEST_SOURCE_URL=https://www.crazygames.com/game/<slug>
